# Local HTTP port; Render supplies PORT automatically.
PORT=5000
# Use production on Render for Secure cross-site cookies.
NODE_ENV=development
# MongoDB connection string; replace placeholders and URL-encode credentials.
MONGO_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/portfolio
# Generate a long random signing secret; never commit the real value.
JWT_SECRET=replace_with_a_long_random_secret
# Exact comma-separated frontend origins, with no trailing slashes.
CLIENT_URL=http://localhost:3000
# Used only by npm run seed:admin.
ADMIN_EMAIL=admin@example.com
# Used only by npm run seed:admin; replace before running the seed.
ADMIN_PASSWORD=replace_with_a_strong_admin_password
# SMTP hostname; optional until email notifications are configured.
EMAIL_HOST=smtp.gmail.com
# SMTP port.
EMAIL_PORT=465
# Enable TLS for SMTP port 465.
EMAIL_SECURE=true
# Optional SMTP username; leave blank to defer notifications.
EMAIL_USER=
# Optional replacement app password; never use the revoked password.
EMAIL_PASS=
# Optional notification recipient; set explicitly when enabling email.
CONTACT_NOTIFY_TO=
# Optional sender address; defaults to EMAIL_USER.
CONTACT_NOTIFY_FROM=
