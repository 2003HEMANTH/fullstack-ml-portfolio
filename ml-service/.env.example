# Local Flask port; Render supplies PORT automatically.
PORT=8000
# Exact comma-separated frontend origins, with no trailing slashes; no wildcard.
CORS_ORIGINS=http://localhost:3000
# Keep the real key only in local and Render environment variables.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
